# GEMINI_API_KEY: Required for server-side FAQ translation into regional Indian languages.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing student session Bearer tokens.
SESSION_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"

# GOOGLE_SHEETS_WEBHOOK: Deployed Google Apps Script Web App URL (/exec) connecting both spreadsheets.
GOOGLE_SHEETS_WEBHOOK=""

# GOOGLE_SHEETS_WEBHOOK_SECRET: Optional shared secret matching Script Properties WEBHOOK_SECRET in Apps Script.
GOOGLE_SHEETS_WEBHOOK_SECRET=""
